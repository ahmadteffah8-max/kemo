<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:layoutDirection="ltr">

    <TextureView
        android:id="@+id/bgVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom"
        android:rotation="180" />

    <ImageButton
        android:id="@+id/muteBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_dim"
        android:contentDescription="@string/cd_mute"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="36dp"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">

        <Button
            android:id="@+id/openButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/btn_accent"
            android:stateListAnimator="@null"
            android:text="@string/open_files"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/recordButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="@string/record_screen"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/trimButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:text="@string/trim_video"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
